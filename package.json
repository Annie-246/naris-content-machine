{
  "name": "naris-content-machine",
  "private": true,
  "version": "1.0.2",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "start": "node server/production.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "node --test services/radar/radar.test.mjs services/zip.test.mjs services/productCatalog.test.mjs server/douyinVideo.test.mjs",
    "app": "npm run build && electron .",
    "app:nobuild": "electron .",
    "dist": "npm run build && electron-builder --win",
    "vendor": "node scripts/fetch-vendor.mjs",
    "predist": "node scripts/fetch-vendor.mjs",
    "dist:mac": "npm run build && electron-builder --mac"
  },
  "dependencies": {
    "@google/genai": "^1.51.0",
    "@tailwindcss/vite": "^4.2.4",
    "lucide-react": "^0.555.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwindcss": "^4.2.4"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^44.1.1",
    "electron-builder": "^26.15.3",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  },
  "build": {
    "appId": "com.naris.contentmachine",
    "productName": "Naris Content Machine",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**",
      "dist/**",
      "server/**",
      "services/radar/**",
      "package.json",
      "build/icon.ico"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Naris Content Machine"
    },
    "electronDist": "node_modules/electron/dist",
    "extraResources": [
      {
        "from": "vendor",
        "to": "vendor",
        "filter": [
          "**/*"
        ]
      }
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "category": "public.app-category.productivity",
      "identity": "-",
      "hardenedRuntime": false,
      "gatekeeperAssess": false
    },
    "dmg": {
      "title": "Naris Content Machine"
    }
  }
}
